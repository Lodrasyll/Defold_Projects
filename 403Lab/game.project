[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[script]
shared_state = 1

[display]
width = 1280
height = 720
high_dpi = 1
display_device_info = 0

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch

[project]
title = 403LAB
version = 0.1
dependencies#0 = https://github.com/subsoap/defos/archive/master.zip
dependencies#1 = https://github.com/britzl/defold-input/archive/refs/tags/4.7.0.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.1.6.zip
dependencies#3 = https://github.com/Insality/defold-event/archive/refs/tags/12.zip
dependencies#4 = https://github.com/Insality/defold-tweener/archive/refs/tags/5.zip
dependencies#5 = https://github.com/Insality/panthera/archive/refs/tags/runtime.5.zip
dependencies#6 = https://github.com/Insality/defold-saver/archive/refs/tags/5.zip
dependencies#7 = https://github.com/Insality/defold-lang/archive/refs/tags/4.zip

[render]
clear_color_alpha = 1.0

[font]
runtime_generation = 1

[graphics]
default_texture_mag_filter = nearest
default_texture_min_filter = nearest

[particle_fx]
max_particle_count = 2048
max_particle_buffer_count = 2048

