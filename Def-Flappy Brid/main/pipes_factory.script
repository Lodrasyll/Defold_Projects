---@package
---@param self pipe_factory.script
function init(self)
	math.random(os.time())

	self.timer = 0
	self.spawn_pipes = {}
	self.pipe_gap = 80
end

---@package
---@param self pipes_factory.script
---@param dt number
function update(self, dt)
	-- 如果处于标题开始状态
	if game_manager.game_state == 'play_state' then
		self.timer = self.timer + dt
		if self.timer >= spawn_time then
			spawn_pipe(self)
			self.timer = 0
		end
	end
