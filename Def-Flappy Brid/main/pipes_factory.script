local spawn_time = 2.5
local component = '#pipes_factory'
local gap = 0
local spawn_x = SCREEN_WIDTH + 60
local center_y = SCREEN_HEIGHT / 2


local function spawn_pipe(self)
	local pos = go.get_position()
	pos = vmath.vector3(spawn_x, math.random(-self.pipe_gap, self.pipe_gap), 0)
	local id = factory.create(component, pos, nil, { scored = false })
	table.insert(self.spawn_pipes, id)
end

