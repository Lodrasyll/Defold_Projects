local druid = require('druid.druid')

local function start_game(self)
    msg.post('main:/game_loader', 'goto_select_scene')
end

local function start_or_quit(self)
    self.start_button.on_click:subscribe(function()
        start_game(self)
    end)
    self.quit_button.on_click:subscribe(function()
        sys.exit(0)
    end)
end

---@package
---@param self menu_controller.gui_script
function init(self)
    msg.post('.', 'acquire_input_focus')
    self.druid = druid.new(self)

    self.start_button = self.druid:new_button('start_button')
    self.quit_button = self.druid:new_button('quit_button')
    self.selected = 1

    start_or_quit(self)
end

---@package
---@param self menu_controller.gui_script
function final(self)
    self.druid:final()
end

---@package
---@param self menu_controller.gui_script
---@param dt number
function update(self, dt)
    self.druid:update(dt)

    if self.selected == 1 then
        gui.set(gui.get_node('start_button_text'), 'color', vmath.vector4(1, 0, 0, 1))
    end
end

---@package
---@param self menu_controller.gui_script
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
    self.druid:on_message(message_id, message, sender)
end

---@package
---@param self menu_controller.gui_script
---@param action_id hash
---@param action on_input.action
---@return boolean|nil
function on_input(self, action_id, action)
    if action_id == hash('start') and action.pressed then
        start_game(self)
    end
    if action_id == hash('up') or self.selected == 2 then
        self.selected = 1
    elseif action_id == hash('down') and self.selected == 1 then
        self.selected = 2
    end

    return self.druid:on_input(action_id, action)
end



