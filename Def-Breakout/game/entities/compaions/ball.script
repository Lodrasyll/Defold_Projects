local lume = require('lib.thirdparty.lume')
local sound_controller = require('scenes.shared.sound_controller')
local game_manager = require('game.managers.game_manager')

go.property('speed', 400)
local paddle_id


local function player_dead(self)
	msg.post('/level_manager', 'player_dead', { hp = self.hp })
end

local function brick_bounce_particlefx(message)
	-- 1. 获取被撞砖块的位置
	-- message.other_id 是被撞到的砖块的ID
	local brick_pos = go.get_position(message.other_id)
	-- 2. 在砖块的位置生成爆炸对象 工厂组件在当前脚本所在的 URL 下
	factory.create("/factory#star_explosion", brick_pos)
end

local function wall_bounce_sound()
	sound_controller.play('wall_hit', sound_controller.GROUP_SFX)
end

local function paddle_bounce_sound()
	sound_controller.play('paddle_hit', sound_controller.GROUP_SFX)
end

local function brick_bounce_sound()
	sound_controller.play('brick_hit_2', sound_controller.GROUP_SFX)
end

local function ball_dead(self)
	self.hp = self.hp - 1
	self.dead = true
	msg.post('/level_gui', 'dead', { hp = self.hp })
	-- print(self.hp)
	sound_controller.play('hurt', sound_controller.GROUP_SFX)
end

local function serve(self)
	local direction = vmath.vector3(math.random(-5, 5), math.random(1, 3), 0)
	-- 游戏体验改进
	if math.abs(direction.x) < 0.1 then
		direction.x = math.random(-5, 5)
	end
	self.direction = vmath.normalize(direction)
	self.current_speed = self.init_speed
	game_manager.set_state('play_state')
end


local function reset(self)
	self.dead = false
	go.set_position(self.init_pos)
	self.direction = vmath.vector3()
	self.current_speed = self.init_speed
	game_manager.set_state('serve_state')
end

local function debugger(self)
	-- === 可视化调试代码 ===
	-- 1. 确定起止点
	local start_point = go.get_position()
	-- 2. 计算终点：沿着当前方向延伸 50 个像素
	local end_point = start_point + (self.direction * 50)

	-- 3. 发送绘制消息给渲染器
	-- 注意：这个线条只存在于当前帧，所以必须在 update 中每帧都调用
	msg.post("@render:", "draw_line", {
		start_point = start_point,
		end_point = end_point,
		color = vmath.vector4(1, 0, 0, 1) -- 红色 (R, G, B, Alpha)
	})

	-- 你甚至可以画出文本来显示当前速度
	msg.post("@render:", "draw_text", {
		text = "Speed: " .. tostring(math.floor(self.current_speed)),
		position = start_point + vmath.vector3(10, 10, 0),
		color = vmath.vector4(0, 1, 0, 1) -- 绿色
	})
end

---@package
---@param self ball.script
function init(self)
	msg.post('.', 'acquire_input_focus')
	math.randomseed(os.time())
	
	self.init_pos = go.get_position()
	self.init_speed = go.get('#', 'speed')
	self.current_speed = self.init_speed
	self.direction = vmath.vector3()
	self.dead = false
	self.hp = 3
end

---@package
---@param self ball.script
---@param dt number
function update(self, dt)
	if game_manager.get_state() == 'serve_state' then
		local paddle_pos = go.get_position(paddle_id)
		paddle_pos.y = go.get_position().y
		go.set_position(paddle_pos)
	elseif game_manager.get_state() == 'play_state' then
		local pos = go.get_position()
		pos = pos + self.current_speed * self.direction * dt
		go.set_position(pos)

		-- 限制球的最大速度
		self.current_speed = lume.clamp(self.current_speed, self.init_speed, 1100)

		-- 检测球是否死亡
		if pos.y < 0 then ball_dead(self) end
		-- 死亡便重新发球
		if self.dead then reset(self) end
		-- 检测是否无法继续游戏
		if self.hp <= 0 then
			msg.post('.', 'disable')
		end

		if self.hp == 0 then
			player_dead(self)
		end
	end

	-- === 调试模块 ===
	debugger(self)
	-- print(self.current_speed)
end

---@package
---@param self ball.script
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
	-- 碰撞反弹检测
	if message_id == hash('contact_point_response') then
		-- 分离碰撞体，防止卡住
		local new_pos = go.get_position() + message.distance * message.normal
		go.set_position(new_pos)

		-- 获取数据
		local is_paddle = message.group == hash('paddle')
		local paddle_is_move = false

		if is_paddle then
			-- 动态获取paddle脚本的script中暴露的属性
			local paddle_url = msg.url(nil, message.other_id, 'player_script')
			local status, paddle_move_dir = pcall(go.get, paddle_url, 'current_move_dir')
			if status and paddle_move_dir ~= 0 then
				paddle_is_move = true
			end
		end
		
		-- 游戏体验预期改进：球拍引导球的方向，球拍的不同击中点会施加不同加速度，边缘最快 return dx-velocity or constant？
		-- 不返回一个计算出来的dx/velocity 而是在分别修改方向与速度
		if is_paddle and paddle_is_move then
			self.current_speed = 600
			-- 路径 A: 偏移算法 (球拍移动中 -> 玩家控制)
			-- 获取ball_pos paddle_pos
			local ball_pos = go.get_position()
			local paddle_pos = go.get_position(message.other_id)
			-- 动态获取paddle_center_point即半宽 先构建球拍sprite的url后使用go.get()方法动态获取
			local paddle_sprite_url = msg.url(nil, message.other_id, 'sprite')
			local paddle_half_w = go.get(paddle_sprite_url, 'size.x') / 2


			-- is_left or is_right offset_x > 0在左，反之在右 = ball_pos - paddle_center
			local offset_x = ball_pos.x - paddle_pos.x

			-- -- offset_x 1 or -1 将偏移值归一化
			local normalized_offset = offset_x / paddle_half_w
			normalized_offset = lume.clamp(normalized_offset, -1, 1)

			-- 修改与应用到方向 constant k
			local CONSTANT_K = 0.8
			local new_dir_x = normalized_offset * CONSTANT_K
			local new_dir_y = 1.0
			self.direction.x = new_dir_x
			self.direction.y = new_dir_y
			self.direction = vmath.normalize(self.direction)

			-- 修改与应用到速度（加速系数）init_bounce_power
			local bounce_power = 300
			local speed_boost = math.abs(normalized_offset) * bounce_power
			self.current_speed = self.current_speed + speed_boost
		else
			-- 正确的计算反弹
			-- 路径 B: 反射算法 (球拍静止 或 撞墙/砖块 -> 物理反弹)
			local dot = vmath.dot(self.direction, message.normal)
			local new_dir = self.direction - 2 * dot * message.normal

			-- 计算反弹后的游戏体验改进
			if math.abs(new_dir.x) < 0.05 then
				local sign = 1
				if new_dir.x < 0 then sign = -1 end
				new_dir.x = 0.15 * sign
			elseif math.abs(new_dir.x) > 0.9 then
				local sign = 1
				if new_dir.x < 0 then sign = -1 end
				new_dir.x = 0.8 * sign
			end
			
			self.direction = vmath.normalize(new_dir)
			self.current_speed = self.current_speed * 1.013
		end
	end

	-- 根据碰撞组类型: 播放反馈音效，播放粒子，计算分数
	if message_id == hash('contact_point_response') then
		if message.group == hash('wall') then
			wall_bounce_sound()
		elseif message.group == hash('paddle') then
			paddle_bounce_sound()
		elseif message.group == hash('brick') then
			brick_bounce_sound()
			brick_bounce_particlefx(message)

			-- local brick_id = message.other_id
			-- local brick_script_url = msg.url(nil, brick_id, 'brick_script')
			-- local brick_type = go.get(brick_script_url, 'type')
			-- print(brick_type)
		end
	end

	-- 获取球拍生成实例的id
	if message_id == hash('player_id_is') then
		paddle_id = message.id
	end
end

---@package
---@param self ball.script
---@param action_id hash
---@param action on_input.action
---@return boolean|nil
function on_input(self, action_id, action)
	if action_id == hash('serve') and action.pressed and game_manager.get_state() == 'serve_state' then
		serve(self)
	end
end