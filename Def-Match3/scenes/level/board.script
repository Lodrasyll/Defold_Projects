stabilize = function (self)
	local drop_tween = match3.collapse()
	local spawn_list = match3.fill_board()
	local max_delay = 0 -- 追踪最长的动画时间

	for block, _ in pairs(drop_tween) do
		local target_pos = match3.slot_to_screen(block.x, block.y)
		go.animate(block.id, 'position', go.PLAYBACK_ONCE_FORWARD, target_pos, go.EASING_OUTBOUNCE, 0.6, 0)
		max_delay = math.max(max_delay, 0.6)
	end

	for _, info in pairs(spawn_list) do
		local block = info.block
		local start_pos = match3.slot_to_screen(block.x, info.from_y)
		go.set_position(start_pos, block.id)

		local target_pos = match3.slot_to_screen(block.x, block.y)
		go.animate(block.id, 'position', go.PLAYBACK_ONCE_FORWARD, target_pos, go.EASING_OUTBOUNCE, 0.5, 0)
		max_delay = math.max(max_delay, 0.5)
	end

	timer.delay(max_delay, false, function()
		check_matches(self)
	end)
end

check_matches = function (self)
	local matches_set, has_match = match3.find_match_block()
	if has_match then
		match3.remove_match_block(matches_set)

		-- 消除动画播完后，触发下落和填充
		timer.delay(0.2, false, function()
			stabilize(self)
		end)
	end
end

-- 早期设计架构，直接调用生成棋盘
local function build_board()
	local board = {}
	local pos_offset = game_data.board_spawn_pos
	local x = 0
	local y = 0
	for x = 0, board_width - 1 do
		local px = pos_offset.x + slot_size / 2 + slot_size * x
		board[x] = {}
		for y = 0, board_height - 1 do
			local py = pos_offset.y + slot_size / 2 + slot_size * y
			local pos = vmath.vector3(px, py, 0.5)
			local color = game_data.colors_list[math.random(#game_data.colors_list)]
			local id = factory.create('#factory_board', pos, nil, { color = hash(color) })
			board[x][y] = {
				id = id,
				x = x,
				y = y,
				pos = pos,
				color = hash(color)
			}
		end
	end
	return board
end
-- 中期重构架构，使用match3模块生成
local function board_init(self)
	-- 1.拿到棋盘的id
	local board_id = go.get_id()

	-- 2.初始化大脑，教会它怎么造方块
	match3.init({
		-- 定义创建棋盘方块回调函数
		on_create_block = function(x, y, color, local_pos)
			-- a.准备属性
			local properties = { color = hash(color) }

			-- b.此时local_pos是类似（40,40）这种小数值
			-- 我们先用这个位置创建出来
			local id = factory.create('/board#factory_board', local_pos, nil, properties)

			-- c.【核心魔法】设置父节点，认父归宗
			-- keep_world_transform = 0 意思是‘把我的坐标当成相对于父节点的坐标’
			msg.post(id, 'set_parent', { parent_id = board_id, keep_world_transform = 0 })

			-- d.返回id给大脑存档
			return id
		end,

		-- 定义交换棋盘方块回调函数
		on_swap_block = function(block_a, block_b, on_complete)
			-- 这里的 block_a 和 block_b 已经是交换过 x,y 数据的了
			-- 我们只需要让它们移动到对方的“逻辑坐标”对应的“物理位置”去
			
			local pos_a = match3.slot_to_screen(block_a.x, block_a.y)
			local pos_b = match3.slot_to_screen(block_b.x, block_b.y)

			go.animate(block_a.id, 'position', go.PLAYBACK_ONCE_FORWARD, pos_a, go.EASING_OUTQUAD, 0.3)
			go.animate(block_b.id, 'position', go.PLAYBACK_ONCE_FORWARD, pos_b, go.EASING_OUTQUAD, 0.3, 0, function ()

				check_matches(self)
				-- if on_complete then on_complete() end
			end)
		end,

		-- 定义移除棋盘方块回调函数
		on_remove_block = function (block)
			local id = block.id
			local local_pos = go.get_position(id)
			local board_world_pos = go.get_position('/board')
			
			go.animate(id, 'scale', go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.4, 1.4, 0), go.EASING_INBACK, 0.3, 0, function ()
				go.animate(id, 'scale', go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0, 0, 0), go.EASING_INBACK, 0.2, 0, function ()
					factory.create("/board#factory_explosion", local_pos + board_world_pos)
					go.delete(id)
				end)
			end)
			-- particlefx.play("star_explosion")
		end
	})

	-- 3.下令开始创建
	print('开始构建棋盘，，，')
	match3.create_board(self.width, self.height, self.block_size)
	check_matches(self)
end



---@package
---@param self board.script
function init(self)
	math.randomseed(os.time())
	board_init(self)
	
end


---@package
---@param self board.script
---@param dt number
function update(self, dt)

end

