local match3 = require('scenes.shared.match3')

go.property('color', hash('nil'))

---@package
---@param self brick_script.script
function init(self)
    if self.color ~= hash('nil') then
        local color = match3.colors_map[self.color]
        sprite.play_flipbook('#sprite', 'brick_' .. color)
    end
end
