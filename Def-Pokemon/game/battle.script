local StateStack = require('game.statestack.state_stack')
local States = require('core.systems.battle_states')


---@package
---@param self battle.script
function init(self)
	-- 创建状态栈
	self.stack = StateStack.create(self)
	--  初始状态：主菜单
	self.stack.push(States)
end

---@package
---@param self battle.script
---@param dt number
function update(self, dt)
	
end