    -- Flow.wait(0.5)
    -- -- 3. 敌人受击表现与扣血
    -- print("敌人掉血...")
    -- -- 通知 GUI 播血条动画
    -- msg.post("/monarch#level_3", "animate_hp", { target = "enemy", amount = -20 })
    -- -- 【关键】等待 GUI 传回信号
    -- Flow.wait_for_signal("hp_anim_finished")
    -- Flow.wait(1.0)
    -- -- 计算伤害后显示第二条信息
    -- local text = '这非常有效！'
    -- self:show_message(text)
    -- -- 4. 检查是否结束
    -- if self.enemy_data.hp <= 0 then
    --     -- 胜负逻辑...
    -- end
    -- -- 5. 【极其重要】剧本演完了，告诉状态栈：我们可以回菜单了
    -- print("【剧本结束】")
