[bootstrap]
main_collection = /main.collectionc
render = /orthographic/render/orthographic.renderc

[script]
shared_state = 1

[display]
width = 1920
height = 1080
high_dpi = 1

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch

[project]
title = Def-Pokemon
dependencies#0 = https://github.com/Insality/asset-store/archive/refs/tags/1.zip
dependencies#1 = https://github.com/paweljarosz/editor-scripts-ui-collection/archive/master.zip
dependencies#2 = https://github.com/Insality/defold-event/archive/refs/tags/13.zip
dependencies#3 = https://github.com/Insality/druid/archive/refs/tags/1.1.6.zip
dependencies#4 = https://github.com/britzl/defold-orthographic/archive/refs/tags/3.4.1.zip
dependencies#5 = https://github.com/britzl/defold-input/archive/refs/tags/4.7.0.zip
dependencies#6 = https://github.com/subsoap/defos/archive/refs/tags/v2.8.4.zip
dependencies#7 = https://github.com/Insality/defold-tweener/archive/refs/tags/6.zip
dependencies#8 = https://github.com/Insality/panthera/archive/refs/tags/runtime.6.zip
dependencies#9 = https://github.com/subsoap/defsave/archive/refs/tags/v1.2.6.zip
dependencies#10 = https://github.com/Insality/defold-lang/archive/refs/tags/4.zip
dependencies#11 = https://github.com/britzl/monarch/archive/refs/tags/5.2.0.zip
dependencies#12 = https://github.com/britzl/ludobits/archive/refs/tags/7.5.0.zip

[input]
game_binding = /game.input_bindingc

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest
max_debug_vertices = 300000

[tilemap]
max_tile_count = 10480

[physics]
debug = 0
max_collision_object_count = 10240
max_collisions = 256
debug_alpha = 0.5

[collection]
max_instances = 10240

