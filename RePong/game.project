[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch

[project]
title = RePong
dependencies = 

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[render]
