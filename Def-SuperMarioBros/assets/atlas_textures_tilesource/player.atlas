images {
  image: "/assets/arts/star.png"
}
animations {
  id: "run"
  images {
    image: "/assets/sprites/Characters/Default/character_purple_walk_a.png"
    sprite_trim_mode: SPRITE_TRIM_MODE_8
  }
  images {
    image: "/assets/sprites/Characters/Default/character_purple_walk_b.png"
    sprite_trim_mode: SPRITE_TRIM_MODE_8
  }
  playback: PLAYBACK_LOOP_FORWARD
  fps: 8
}
animations {
  id: "idle"
  images {
    image: "/assets/sprites/Characters/Default/character_purple_idle.png"
    sprite_trim_mode: SPRITE_TRIM_MODE_8
  }
